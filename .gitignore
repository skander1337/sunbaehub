# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sunbae: local database, uploads, design review captures
dev.db
dev.db-*
/uploads/*
!/uploads/.gitkeep
.impeccable/review/
/recordings/

# local agent/tool configs and design-tool session state (machine-specific)
.claude/
.codex/
.grok/
.impeccable/config.local.json
.impeccable/questions/
